{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default-msvc-debug",
            "displayName": "Default (MSVC + vcpkg)",
            "generator": "Ninja",
            "description": "Configure using MSVC and vcpkg integration.",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "default-msvc-release",
            "displayName": "Default (MSVC + vcpkg)",
            "generator": "Ninja",
            "description": "Configure using MSVC and vcpkg integration.",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-vcpkg-debug",
            "displayName": "Clang (LLVM) + vcpkg",
            "generator": "Ninja",
            "description": "Configure using Clang/LLVM and vcpkg integration.",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-vcpkg-release",
            "displayName": "Clang (LLVM) + vcpkg",
            "generator": "Ninja",
            "description": "Configure using Clang/LLVM and vcpkg integration.",
            "hidden": false,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default-msvc-debug",
            "configurePreset": "default-msvc-debug"
        },
        {
            "name": "default-msvc-release",
            "configurePreset": "default-msvc-release"
        },
        {
            "name": "clang-vcpkg-debug",
            "configurePreset": "clang-vcpkg-debug"
        },
        {
            "name": "clang-vcpkg-release",
            "configurePreset": "clang-vcpkg-release"
        },
        {
            "name": "release",
            "description": "",
            "displayName": "",
            "inherits": [
                "clang-vcpkg-release"
            ]
        }
    ]
}